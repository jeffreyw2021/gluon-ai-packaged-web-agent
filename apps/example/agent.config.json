{
  "model": "gpt-4o",
  "systemPrompt": "You are a helpful assistant with access to weather and calculator tools. Be concise and helpful.",
  "maxOutputTokens": 8192,
  "maxRounds": 20,
  "tools": {
    "get_weather": "./agent/tools/getWeather.ts",
    "calculator": "./agent/tools/calculator.ts"
  },
  "actionBlocks": {
    "get_weather": "./agent/blocks/WeatherBlock.tsx"
  },
  "skills": [],
  "auth": {
    "getUserId": "./agent/auth/getUserId.ts"
  },
  "sendReasoning": false,
  "suggestedPrompts": [
    "What's the weather like in New York?",
    "Calculate 15% tip on a $87.50 bill.",
    "Compare the weather in Tokyo vs London."
  ],
  "env": {
    "openaiApiKey": "OPENAI_API_KEY",
    "databaseUrl": "DATABASE_URL",
    "redisUrl": "REDIS_URL"
  }
}
