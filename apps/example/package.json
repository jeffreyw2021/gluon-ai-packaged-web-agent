{
  "name": "example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n gluon,app -c blue,green \"npm run gluon:start\" \"npm run dev:app\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:app": "next dev",
    "gluon:start": "node --env-file=.env ./node_modules/.bin/gluon-ai start",
    "gluon:uninstall": "npx gluon-ai uninstall"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.90",
    "gluon-ai": "^0.1.0-beta.105",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "gluon-ai@0.1.0-beta.105": true
  }
}
