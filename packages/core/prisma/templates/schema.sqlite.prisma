// gluon-ai — package-owned schema (SQLite — great for local dev / embedded).
// Generated into ./generated/ by `postinstall` or `npx gluon-ai init`.
//
// Note: SQLite stores Json as TEXT. Prisma serialises/deserialises transparently.

generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("AGENT_DATABASE_URL")
}

model GluonChat {
  id             String             @id @default(cuid())
  userId         String
  title          String             @default("New Chat")
  uiMessages     Json               @default("[]")
  activeJobRunId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  jobRuns        GluonChatJobRun[]

  @@index([userId])
  @@map("gluon_chat")
}

model GluonChatJobRun {
  id                            String    @id @default(cuid())
  chatId                        String
  chat                          GluonChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId                        String
  status                        String    @default("QUEUED")
  bullmqJobId                   String?   @unique
  currentRoundIndex             Int       @default(0)
  pendingConfirmationToolCallId String?
  confirmationResolvedIds       Json      @default("[]")
  lastPublishedSeq              Int       @default(0)
  errorMessage                  String?
  startedAt                     DateTime?
  finishedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([chatId, status])
  @@map("gluon_chat_job_run")
}
