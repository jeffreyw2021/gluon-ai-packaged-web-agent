// gluon-ai — package-owned schema (MySQL / MariaDB).
// Generated into ./generated/ by `postinstall` or `npx gluon-ai init`.

generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("AGENT_DATABASE_URL")
}

model GluonChat {
  id             String             @id @default(cuid())
  userId         String
  title          String             @default("New Chat") @db.VarChar(255)
  uiMessages     Json               @default("[]")
  activeJobRunId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  jobRuns        GluonChatJobRun[]

  @@index([userId])
  @@map("gluon_chat")
}

model GluonChatJobRun {
  id                            String    @id @default(cuid())
  chatId                        String
  chat                          GluonChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId                        String
  status                        String    @default("QUEUED") @db.VarChar(32)
  bullmqJobId                   String?   @unique @db.VarChar(255)
  currentRoundIndex             Int       @default(0)
  pendingConfirmationToolCallId String?   @db.VarChar(255)
  confirmationResolvedIds       Json      @default("[]")
  lastPublishedSeq              Int       @default(0)
  errorMessage                  String?   @db.Text
  startedAt                     DateTime?
  finishedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([chatId, status])
  @@map("gluon_chat_job_run")
}
