{
  "name": "gluon-ai",
  "version": "0.1.0-beta.124",
  "description": "Drop-in AI chat agent for Next.js — streaming, multi-chat, tool use, configuration-first",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./routes": {
      "import": "./dist/routes.js",
      "require": "./dist/routes.js",
      "default": "./dist/routes.js",
      "types": "./dist/routes.d.ts"
    },
    "./tool": {
      "import": "./dist/tool.mjs",
      "require": "./dist/tool.js",
      "types": "./dist/tool.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./instrumentation": {
      "import": "./dist/instrumentation.mjs",
      "require": "./dist/instrumentation.js",
      "types": "./dist/instrumentation.d.ts"
    },
    "./cli": {
      "require": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./app": {
      "require": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/templates",
    "cli",
    "scripts",
    "agent.config.schema.json"
  ],
  "bin": {
    "gluon-ai": "./cli/bin.js"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "build": "npm run prisma:generate && tsup",
    "dev": "npm run prisma:generate && tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node_modules/.bin/eslint src",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=1",
    "@ai-sdk/deepseek": ">=1",
    "@ai-sdk/google": ">=1",
    "@ai-sdk/groq": ">=1",
    "@ai-sdk/mistral": ">=1",
    "@ai-sdk/openai": ">=3",
    "@ai-sdk/xai": ">=1",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@ai-sdk/deepseek": {
      "optional": true
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@prisma/client": "^6.8.2",
    "@tanstack/react-query": "^5.76.2",
    "ai": "^6.0.237",
    "bullmq": "^5.34.8",
    "hono": "^4.12.33",
    "ioredis": "^5.6.0",
    "jotai": "^2.12.5",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react-markdown": "^10.1.0",
    "redis": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/groq": "^4.0.19",
    "@ai-sdk/mistral": "^4.0.20",
    "@ai-sdk/openai": "^3.0.89",
    "@ai-sdk/xai": "^4.0.25",
    "@types/node": "^22",
    "@types/react": "^19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prisma": "^6.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
